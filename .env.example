# ============================================
# Hyper Messenger - Environment Variables
# ============================================
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to git!

# ============================================
# Application
# ============================================
NODE_ENV=development
VITE_APP_NAME=Hyper Messenger
VITE_APP_VERSION=1.0.0
VITE_BASE_URL=http://localhost:5173

# ============================================
# API Configuration
# ============================================
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3000/ws
VITE_API_TIMEOUT=30000

# ============================================
# Authentication
# ============================================
VITE_AUTH_TOKEN_KEY=hyper_auth_token
VITE_AUTH_REFRESH_KEY=hyper_refresh_token
VITE_SESSION_TIMEOUT=900000  # 15 minutes in ms

# ============================================
# Feature Flags
# ============================================
VITE_ENABLE_AI_ASSISTANT=true
VITE_ENABLE_VIDEO_CALLS=true
VITE_ENABLE_STORIES=true
VITE_ENABLE_VOICE_MESSAGES=true

# ============================================
# External Services (Optional)
# ============================================
# Sentry Error Tracking
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# Analytics
VITE_ANALYTICS_ID=
VITE_ANALYTICS_ENABLED=false

# ============================================
# Admin Panel (Development Only)
# ============================================
# WARNING: These are for demo purposes only
# In production, admin auth is handled server-side
VITE_ADMIN_DEMO_USER=admin
VITE_ADMIN_DEMO_PASS=hyper2026
VITE_ADMIN_DEMO_TOTP=000000

# ============================================
# Security
# ============================================
VITE_ENCRYPTION_ENABLED=true
VITE_E2EE_ENABLED=true
VITE_CONTENT_SECURITY_POLICY=default-src 'self'

# ============================================
# Media & Upload
# ============================================
VITE_MAX_FILE_SIZE=104857600  # 100MB
VITE_MAX_IMAGE_SIZE=10485760  # 10MB
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
VITE_ALLOWED_VIDEO_TYPES=video/mp4,video/webm

# ============================================
# Performance
# ============================================
VITE_CACHE_ENABLED=true
VITE_CACHE_DURATION=86400  # 24 hours
VITE_PWA_ENABLED=false
VITE_SERVICE_WORKER_ENABLED=false
